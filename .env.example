# Isi nilai-nilai ini di Vercel: Project → Settings → Environment Variables.
# JANGAN pernah menulis nilai aslinya ke berkas ini atau ke repo.

# OAuth client dari Google Cloud Console (project VeritasAI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token pemilik Google Drive tujuan (dibuat sekali via OAuth Playground
# dengan OAuth client di atas; scope: spreadsheets + drive.file)
GOOGLE_REFRESH_TOKEN=

# ID Google Sheet "VeritasAI — Hasil Analisis" (bagian URL: /spreadsheets/d/<ID>/edit)
HASIL_SHEET_ID=
